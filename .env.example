# Copy to .env (gitignored). Never commit a real key.
# Fastweb issues one key per model: put them in .secrets/fastweb_keys.json (gitignored) as
# {"<model id>": "<key>", ...}. See docs/smoke-fastweb.md.
FASTWEB_BASE_URL=https://spod.ai-factory.fastweb.it/v1
FASTWEB_KEYS_FILE=.secrets/fastweb_keys.json
CHAT_MODEL=google/gemma-4-26B-A4B-it
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
# Speech-to-text: team server on the Mac mini (tools/asr-server/), not Fastweb. The key is
# per consumer: ask for one, never commit it. Replay needs no key, only the same base URL.
ASR_BASE_URL=https://hack-sst.lorenzocorallo.net/v1
ASR_API_KEY=
ASR_MODEL=openai/whisper-large-v3-turbo
# live: call the API | record: call and cache | replay: cache only, a miss is an error
LLM_MODE=replay
# 1: API and CLI use the fixture namespace (data/tessera_fixture.db, `tessera fixtures load`)
FIXTURE_MODE=0
