{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "com.tessera.maison": {
      "system": "Maison",
      "generatedAt": "2026-10-23",
      "policy": "Editorial fashion-house theme: ivory paper, ink type, hairline rules, one signature red used sparingly. Values are design decisions, not measurements of any brand's CSS."
    }
  },
  "primitive": {
    "color": {
      "paper": {
        "canvas": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.960784,
              0.945098,
              0.917647
            ],
            "hex": "#f5f1ea"
          },
          "$extensions": {
            "com.tessera.maison": {
              "note": "Warm ivory page, like an uncoated lookbook stock."
            }
          }
        },
        "sidebar": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.984314,
              0.976471,
              0.960784
            ],
            "hex": "#fbf9f5"
          },
          "$extensions": {
            "com.tessera.maison": {
              "note": "Lighter ivory for the navigation column."
            }
          }
        },
        "white": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
