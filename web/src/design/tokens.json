          "$extensions": {
            "com.tessera.maison": {
              "note": "Geometric sans in the Futura tradition for UI copy."
            }
          }
        },
        "display": {
          "$type": "fontFamily",
          "$value": [
            "Bodoni Moda Variable",
            "Bodoni 72",
            "Didot",
            "Georgia",
            "serif"
          ],
          "$extensions": {
            "com.tessera.maison": {
              "note": "High-contrast Didone for page titles, section headings and key figures."
            }
